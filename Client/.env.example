# ┌─────────────────────────────────────────────────────────────────────┐
# │ MealMate — Client environment variables (.env.example)              │
# │                                                                     │
# │ Copy this file to `.env` and fill in the values.                    │
# │                                                                     │
# │ RULES:                                                              │
# │   • Never prefix secrets with NEXT_PUBLIC_ (browser-readable).      │
# │   • BACKEND_URL, ADMIN_PANEL_KEY are server-side only.              │
# │   • NEXT_PUBLIC_* values are shipped to the browser.                │
# └─────────────────────────────────────────────────────────────────────┘

# ─── Backend (server-side only, never exposed to browser) ─────────────
BACKEND_URL=http://localhost:5000

# ─── Public app URL (used in invite links) ────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:5174

# ─── Socket.IO origin(s) for CSP connect-src (server-side only) ───────
SOCKET_ORIGIN=http://localhost:5000

# ─── Optional: hidden /admin plane ────────────────────────────────────
# Must match the backend's ADMIN_PANEL_KEY. Leave empty when the
# backend does not set it.
ADMIN_PANEL_KEY=

# ─── CAPTCHA (Cloudflare Turnstile) ───────────────────────────────────
# Site key for the support ticket + appeal forms. Pair with the
# backend's TURNSTILE_SECRET. Leave empty to hide the widget (dev/local).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server-side only (never prefix secrets with NEXT_PUBLIC_)
BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_APP_URL=http://localhost:5174

# Socket.IO origin allowed in the CSP connect-src (comma-separated for several)
SOCKET_ORIGIN=http://localhost:5000

# Optional defense-in-depth for the hidden /admin plane; must match the
# backend's ADMIN_PANEL_KEY. Leave empty when the backend does not set it.
ADMIN_PANEL_KEY=

# Cloudflare Turnstile site key for the support ticket + appeal forms.
# Leave empty to hide the widget (dev/local). Pair with the backend's TURNSTILE_SECRET.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

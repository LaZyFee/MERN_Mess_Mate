  "type": "module",
  "scripts": {
    "dev": "next dev -p 5174",
    "build": "next build",
    "start": "next start -p 5174",
    "lint": "eslint .",
    "verify:money": "node scripts/verify-money.mjs",
    "audit:colors": "powershell -NoProfile -Command \"Get-ChildItem src -Recurse -Include *.jsx,*.js,*.css | Where-Object { $_.Name -notin @('globals.css') } | Select-String -Pattern '#[0-9a-fA-F]{3,8}\\b|rgba?\\(|hsla?\\('\"",
    "audit:svg": "powershell -NoProfile -Command \"Get-ChildItem src,public -Recurse -Include *.jsx,*.js,*.html | Select-String -Pattern '<svg|\\.svg'\""
  },
  "dependencies": {
    "axios": "^1.12.2",
    "chart.js": "^4.6.1",
    "next": "^16.4.6",
    "react": "^19.1.1",

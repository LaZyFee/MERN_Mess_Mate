# ┌─────────────────────────────────────────────────────────────────────┐
# │ MealMate — Server environment variables (.env.example)              │
# │                                                                     │
# │ Copy this file to `.env` and fill in the values.                    │
# │ Never commit `.env` — it contains secrets.                          │
# │ Values marked REQUIRED must be set before the server can boot.      │
# └─────────────────────────────────────────────────────────────────────┘

# ─── Runtime ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # development | production | test
DOTENV_CONFIG_SILENT=true

# ─── Database (REQUIRED) ──────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/mealmate
# MONGO_REPLICA_SET=rs0          # REQUIRED in production (transactions need
                                   # a replica set). Unset = standalone dev.
# MONGO_DB_NAME=mealmate        # optional override; otherwise parsed from URI

# ─── Auth / JWT secrets (REQUIRED — regenerate before production) ─────
# Use long, random strings. Do not reuse the example values.
JWT_SECRET=replace-with-a-32-char-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-char-random-secret
SESSION_SECRET=replace-with-express-session-secret

# ─── Legacy refresh-token sunset (D4) ─────────────────────────────────
# Format: YYYY-MM-DD. After this date, plain User.refreshToken (legacy) is
# rejected on /api/users/refresh. Unset = legacy tokens always accepted (dev).
# LEGACY_REFRESH_SUNSET=2027-03-31

# ─── Legacy route sunset (D4) ─────────────────────────────────────────
# Format: YYYY-MM-DD. After this date legacy entry/edit routes return 410.
# LEGACY_SUNSET_DATE=2027-03-31

# ─── Google OAuth ─────────────────────────────────────────────────────
# From Google Cloud Console credentials.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ─── Cloudinary (profile pictures + receipt storage) ──────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# CLOUDINARY_URL is derived from the three above; set explicitly if needed:
# CLOUDINARY_URL=cloudinary://KEY:SECRET@CLOUD_NAME

# ─── Frontend URL (CORS allowlist + CSP connect-src) ──────────────────
FRONTEND_URL=http://localhost:5174

# ─── SMTP / email (outbox channel) ────────────────────────────────────
# Configure with your production SMTP provider before deploy.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=MealMate <no-reply@example.com>

# ─── CAPTCHA (Turnstile) ──────────────────────────────────────────────
# CAPTCHA_PROVIDER=turnstile          # turnstile | hcaptcha | stub
# TURNSTILE_SECRET=your-turnstile-secret   # paired with client site key
# CAPTCHA_DEV_BYPASS=true            # dev/test only: accept any token

# ─── TOTP / 2FA ───────────────────────────────────────────────────────
# TOTP_ENCRYPTION_KEY=replace-with-32-char-aes-key   # encrypts TOTP secrets
# REQUIRE_TOTP_MONEY_ROLES=false    # enforce TOTP for owner/treasurer when true

# ─── Outbox / scheduler ───────────────────────────────────────────────
# OUTBOX_LEASE_MS=120000            # ms before a pending outbox row is reclaimed
# ENABLE_SCHEDULER=true             # set false to skip background jobs (dev)

# ─── Platform admin control plane ─────────────────────────────────────
# Comma-separated admin emails. Denied requests are answered with 404.
ADMIN_EMAILS=admin@example.com
# ADMIN_PANEL_KEY=replace-with-admin-panel-key   # defense-in-depth header key

# ─── WhatsApp (Meta Cloud API) ────────────────────────────────────────
# WhatsApp outbox channel + webhook verification. Leave unset to run without WA.
# WHATSAPP_TOKEN=your-whatsapp-token
# WHATSAPP_PHONE_ID=your-phone-number-id
# WHATSAPP_APP_SECRET=your-app-secret
# WHATSAPP_TEMPLATE_NAME=your-template-name
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# ─── Auth LRU cache ───────────────────────────────────────────────────
# AUTH_CACHE_MAX=500              # max cached {id, suspended} entries
# AUTH_CACHE_TTL_MS=30000         # cache TTL in ms (~30s default)

# ─── Support ──────────────────────────────────────────────────────────
# SUPPORT_STRICT_TURNS=true       # strict turn-taking on ticket threads
